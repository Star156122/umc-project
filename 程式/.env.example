# 複製成 .env 後再填入；請勿把真實金鑰放回 .env.example 或壓縮檔。
API_KEY=
API_SECRET=
EMAIL=
TSST_TOKEN=
CA_PATH=
CA_PASSWORD=

# Safety flags
ALLOW_REAL_TRADING=false
IS_BACKTEST=true
IS_SIMULATION=true
ONLY_BACKTEST=true

# Data source and target（正式策略與日期以 backtest_config.json 為主）
STRATEGY=breakout
TICK_SOURCE=sinopac
STOCK_CODE=2303
BACKTEST_START=2026-01-01
BACKTEST_END=2026-06-30
BACKFILL_START=2026-02-01
BACKFILL_END=2026-02-28
USE_DATA_CACHE=true
DATA_CACHE_PATH=data/market_data.sqlite3

# Optional verified news/LLM summary file; leave blank to disable.
NEWS_SUMMARY_PATH=

# Position and fees
INITIAL_CAPITAL=100000
ORDER_LOTS=1
POSITION_SIZING=cash_fraction
CAPITAL_UTILIZATION=0.95
HOLDING_MODE=swing
BUY_PRICE=1790
SELL_HOUR=13
SELL_MINUTE=20
STOCK_FEE_RATE=0.001425
STOCK_TAX_RATE=0.003
DAY_TRADE_TAX_RATE=0.0015
APPLY_DAY_TRADE_TAX=true

# K-bar and common trend filter
KBAR_UNIT=m
KBAR_FREQ=5
TREND_MA_PERIOD=120
TREND_SLOPE_LOOKBACK=12
REQUIRE_TREND_FILTER=true
USE_ENTRY_BLOCK=false

# Strategy parameters（批次執行時由 backtest_config.json 的 profile 覆蓋）
MA_FAST_PERIOD=20
MA_MID_PERIOD=60
MA_SLOW_PERIOD=240
MA_EXIT_ON_CROSS=false
ENTRY_NEAR_MA_POINTS=0
ENTRY_START_HOUR=9
ENTRY_START_MINUTE=0
ENTRY_CUTOFF_HOUR=12
ENTRY_CUTOFF_MINUTE=30
ENTRY_BLOCK_START_HOUR=9
ENTRY_BLOCK_START_MINUTE=30
ENTRY_BLOCK_END_HOUR=10
ENTRY_BLOCK_END_MINUTE=0

USE_RSI=true
RSI_PERIOD=14
RSI_BUY_ABOVE=55
RSI_BUY_BELOW=70
RSI_REQUIRE_CROSS=true
USE_RSI_BLOCK=false
RSI_BLOCK_LOW=63
RSI_BLOCK_HIGH=66
RSI_SELL_BELOW=50

USE_MACD=true
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9
MACD_REQUIRE_POSITIVE=true
MACD_EXIT_ON_CROSS=false

BOLLINGER_PERIOD=78
BOLLINGER_STDDEV=2.5
BOLLINGER_RSI_MAX=55
BOLLINGER_MIN_REWARD_PCT=0.006
BOLLINGER_REQUIRE_BULLISH_CANDLE=true

BREAKOUT_ENTRY_PERIOD=60
BREAKOUT_EXIT_PERIOD=30
BREAKOUT_REQUIRE_CROSS=true
BREAKOUT_VOLUME_RATIO=1.1
VOLUME_MA_PERIOD=20
VOTE_REQUIRED=2
VOTE_EXIT_REQUIRED=3

# Risk controls
STOP_LOSS_PCT=0.025
TAKE_PROFIT_PCT=0
MIN_HOLD_BARS=2
COOLDOWN_BARS=6
MAX_ENTRIES_PER_DAY=1
VERBOSE_BARS=false

# MySQL / MariaDB（預設關閉）
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_stock_system
DB_USER=
DB_PASSWORD=
DB_USER_ID=1
STOCK_NAME=聯電

# OpenAI LLM（預設關閉）
LLM_ENABLED=false
LLM_PROVIDER=OpenAI
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_MAX_OUTPUT_TOKENS=1400
LLM_CACHE_PATH=data/llm_cache
LLM_USE_CACHE=true
