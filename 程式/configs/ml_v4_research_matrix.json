      "params": {
        "n_estimators": 200,
        "max_depth": 10,
        "min_samples_leaf": 5,
        "class_weight": "balanced",
        "random_state": 42
      }
    },

    "xgboost": {
      "config_name": "baseline",
      "params": {
        "n_estimators": 150,
        "max_depth": 4,
        "learning_rate": 0.05,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "random_state": 42
      }
    },

    "gru": {
      "config_name": "smaller",
      "params": {
        "hidden_size": 16,
        "num_layers": 1,
        "dropout": 0.0,
        "batch_size": 128,
        "max_epochs": 10,
        "patience": 2,
        "learning_rate": 0.001,
        "random_state": 42
      }
    }
  },

