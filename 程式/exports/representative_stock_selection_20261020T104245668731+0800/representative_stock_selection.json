    "SIDEWAYS_SCORE": "0.40*Z(-abs(total_return_pct))+0.30*Z(-abs(annualized_trend_slope_pct))+0.20*Z(-trend_r2)+0.10*Z(reversal_10d_rate_pct); exclude prior selections"
  },
