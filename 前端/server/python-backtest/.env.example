# Broker credentials. Copy this file to .env and fill in real values locally.
API_KEY=
API_SECRET=
EMAIL=
TSST_TOKEN=
CA_PATH=
CA_PASSWORD=

# Safety flags
ALLOW_REAL_TRADING=false
IS_BACKTEST=true
IS_SIMULATION=true
ONLY_BACKTEST=true

# Data source and target
STRATEGY=ma
TICK_SOURCE=sinopac
STOCK_CODE=2313
BACKTEST_START=2026-01-01
BACKTEST_END=2026-06-30
BACKFILL_START=2026-02-01
BACKFILL_END=2026-02-28

# Position and fees
INITIAL_CAPITAL=100000
ORDER_LOTS=1
BUY_PRICE=1790
SELL_HOUR=13
SELL_MINUTE=20
STOCK_FEE_RATE=0.001425
STOCK_TAX_RATE=0.003

# K-bar settings
KBAR_UNIT=m
KBAR_FREQ=5

# Moving-average strategy
MA_FAST_PERIOD=5
MA_MID_PERIOD=10
MA_SLOW_PERIOD=20
ENTRY_NEAR_MA_POINTS=0
ENTRY_START_HOUR=9
ENTRY_START_MINUTE=0
ENTRY_CUTOFF_HOUR=12
ENTRY_CUTOFF_MINUTE=30
ENTRY_BLOCK_START_HOUR=9
ENTRY_BLOCK_START_MINUTE=30
ENTRY_BLOCK_END_HOUR=10
ENTRY_BLOCK_END_MINUTE=0

# RSI/MACD filters
USE_RSI=true
RSI_PERIOD=14
RSI_BUY_ABOVE=60
RSI_BUY_BELOW=70
RSI_SELL_BELOW=45
USE_MACD=true
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# Risk controls
STOP_LOSS_PCT=0.015
TAKE_PROFIT_PCT=0.03
MIN_HOLD_BARS=2
COOLDOWN_BARS=6
MAX_ENTRIES_PER_DAY=1
