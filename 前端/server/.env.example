PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=umc_topic_integrated
JWT_SECRET=please-change-this-secret

# 真正的 Python 回測後端位置（相對於 server/）
PYTHON_BACKTEST_ROOT=../../程式

# 留空時優先使用 ../../程式/.venv/Scripts/python.exe（Windows）
PYTHON_EXECUTABLE=

# 單次回測最長等待時間（毫秒）
BACKTEST_TIMEOUT_MS=17200000
BACKTEST_TICK_SOURCE=sinopac
BACKTEST_INITIAL_CAPITAL=100000

# Yahoo Finance 行情快取與逾時（毫秒）
YAHOO_MARKET_CACHE_MS=20000
YAHOO_SYMBOL_CACHE_MS=15000
YAHOO_HTTP_TIMEOUT_MS=12000
YAHOO_HOT_LIMIT=8
